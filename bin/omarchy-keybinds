#!/bin/bash
# omarchy:summary=Graphical frontend to view, search, modify, and create Hyprland keybindings.

PLUGIN_ID="meviusisback.keybinds"
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  echo "Usage: omarchy-keybinds [list|set|reset|disable|enable|reload|--print]"
  echo "  (no args)  Open the graphical keybindings manager window"
  echo "  list       Output full JSON model of active binds, catalog, and conflicts"
  echo "  set        Set a keybinding: read one JSON object from stdin"
  echo "  reset      Reset a keybinding to default: read one JSON object from stdin"
  echo "  disable    Disable/unbind a keybinding: read one JSON object from stdin"
  echo "  enable     Re-enable a disabled keybinding: read one JSON object from stdin"
  echo "  reload     Reload the Hyprland configuration"
  echo "  --print    Print keybindings through omarchy-menu-keybindings"
  echo ""
  echo "Write verbs no longer take binding text as arguments: another local account"
  echo "can read argv in /proc. Pipe the JSON payload instead, e.g.:"
  echo "  printf '%s\\n' '{\"key\":\"SUPER + SHIFT + B\",\"description\":\"My Browser\",\"command\":\"omarchy-launch-browser\"}' | omarchy-keybinds set"
  exit 0
fi

# Refuse the old argv form loudly instead of letting the secret land in /proc.
if [[ "$1" == "set" || "$1" == "reset" || "$1" == "disable" || "$1" == "enable" ]] && [[ $# -gt 1 ]]; then
  echo "omarchy-keybinds: $1 no longer accepts binding text as arguments (visible in /proc to other local accounts)." >&2
  echo "Pipe one JSON object to stdin instead:" >&2
  echo "  printf '%s\\n' '{\"key\":\"SUPER + W\",\"description\":\"Close\",\"action\":\"hl.dsp.window.close()\"}' | omarchy-keybinds $1" >&2
  exit 2
fi

if [[ "$1" == "--print" || "$1" == "-p" ]]; then
  omarchy-menu-keybindings --print
  exit 0
fi

if [[ -n "$1" ]]; then
  exec python3 "$REPO_DIR/backend/keybinds_manager.py" "$@"
fi

# Ensure plugin is linked and registered in omarchy-shell
if [[ ! -d "$HOME/.config/omarchy/plugins/$PLUGIN_ID" ]]; then
  mkdir -p "$HOME/.config/omarchy/plugins"
  ln -sfn "$REPO_DIR" "$HOME/.config/omarchy/plugins/$PLUGIN_ID"
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
fi

# Summon the GUI panel. The IPC replies "ok" on success and "unknown" when the
# shell refuses the summon (e.g. the plugin is disabled), with exit code 0 in
# both cases — so fail loudly here instead of leaving a silent no-op.
summon_reply="$(omarchy-shell shell summon "$PLUGIN_ID" '{}')"
if [[ $? -ne 0 ]]; then
  echo "omarchy-keybinds: cannot reach omarchy-shell (is the shell running?)" >&2
  exit 1
fi
if [[ "$summon_reply" != "ok" ]]; then
  echo "omarchy-keybinds: omarchy-shell refused the summon (reply: '${summon_reply:-(empty)}')." >&2
  echo "The plugin is most likely disabled. Enable it with:" >&2
  echo "  omarchy plugin enable $PLUGIN_ID" >&2
  echo "If it still refuses, check the shell log:" >&2
  echo "  journalctl --user --identifier omarchy-shell -f" >&2
  exit 1
fi
